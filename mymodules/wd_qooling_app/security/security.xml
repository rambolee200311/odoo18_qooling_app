<odoo>
    <record id="group_qooling_inbound_user" model="res.groups">
        <field name="name">Qooling Inbound User</field>
        <field name="category_id" ref="base.module_category_operations"/>
    </record>
    <record id="group_qooling_inbound_reviewer" model="res.groups">
        <field name="name">Qooling Inbound Reviewer</field>
        <field name="category_id" ref="base.module_category_operations"/>
        <field name="implied_ids" eval="[(4, ref('wd_qooling_app.group_qooling_inbound_user'))]"/>
    </record>
    <record id="group_qooling_outbound_user" model="res.groups">
        <field name="name">Qooling Outbound User</field>
        <field name="category_id" ref="base.module_category_operations"/>
    </record>
    <record id="group_qooling_outbound_reviewer" model="res.groups">
        <field name="name">Qooling Outbound Reviewer</field>
        <field name="category_id" ref="base.module_category_operations"/>
        <field name="implied_ids" eval="[(4, ref('wd_qooling_app.group_qooling_outbound_user'))]"/>
    </record>
    <record id="rule_qooling_outbound_user" model="ir.rule">
        <field name="name">Outbound forms: authorized users</field>
        <field name="model_id" ref="model_wd_qooling_outbound_form"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('wd_qooling_app.group_qooling_outbound_user'))]"/>
    </record>
</odoo>
